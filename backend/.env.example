# SafeBank AI Backend Environment Configuration

# Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./safebank.db
SQLITE_SYNC_DATABASE_URL=sqlite:///./safebank.db

# Security & Tokens
SECRET_KEY=safebank-insecure-dev-secret-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_EXPIRE_HOURS=24

# WebAuthn / Passkeys
RP_ID=localhost
RP_NAME=SafeBank AI
RP_ORIGINS=https://localhost,http://localhost:8000,android:apk-key-hash:development

# Duress PIN Argon2 settings
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
